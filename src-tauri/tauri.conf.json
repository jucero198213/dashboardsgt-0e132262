{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SGT Workspace",
  "version": "1.0.0",
  "identifier": "com.sgtlog.workspace",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SGT Log - Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RUVFQ0M0MjEwREMwRApSV1FOM0JCQ3pPNStESnYvRkdFaTBLcy9CRVhkeG9RSzk0eHdCaDJVZnVHZHlqeHpoc0pvWnBFSgo=",
      "endpoints": [
        "https://github.com/Pedroauj/Workspace-SGT/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
