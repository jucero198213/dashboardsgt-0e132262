# ── WhatsApp / Sofia (Fase 2) ─────────────────────────────────
# URL da Edge Function automacao-notificar. Deixe VAZIO pra desligar o WhatsApp
# (só e-mail). Preencha quando o template estiver aprovado e a função no ar.
SOFIA_NOTIFY_URL=
# Ex: https://<projeto>.supabase.co/functions/v1/automacao-notificar
# Chave compartilhada (mesma do secret AUTOMACAO_NOTIFY_KEY no Supabase)
AUTOMACAO_NOTIFY_KEY=

# ── WebFile (TSplus) ─────────────────────────────────────────
# Caminho do WebFile dentro do Rodopar (fixo por usuário — não muda entre sessões).
# Descobrir: após login, abrir Explorer dentro do TSplus e ver em "This PC".
WEBFILE_PATH=This PC\WebFile on HZGQIJVRRE8QZU

# ── Planilha MB ──────────────────────────────────────────────
# Nome da aba na planilha gerada pelo processador (não alterar sem motivo)
NOME_PLANILHA_MB=DOCUMENTO

# ── Downloads ────────────────────────────────────────────────
